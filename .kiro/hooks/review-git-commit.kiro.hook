{
  "enabled": true,
  "name": "Review Git Commits",
  "description": "Before shell commands, require explicit user approval for git commit commands.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the pending shell command is a git commit, STOP and show the user the proposed commit message. Ask for explicit approval before proceeding. Do NOT execute a git commit without user confirmation. If the pending shell command is not a git commit, continue normally."
  }
}
