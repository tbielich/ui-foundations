{
  "enabled": true,
  "name": "Cleanup Skill Routing",
  "description": "Before agent responses, route explicit cleanup/refactor/maintainability requests toward the global codebase-cleanup skill without forcing it for unrelated tasks.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the user is asking to clean up the codebase, safely refactor, remove dead code, reduce duplication, improve maintainability, strengthen types, break dependency cycles, or clean error handling, activate or suggest the global `codebase-cleanup` skill. Treat it as a cleanup workflow, not a spec workflow. If the request is ambiguous, ask a short clarifying question or continue without activation."
  }
}
