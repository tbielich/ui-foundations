{
  "enabled": true,
  "name": "Figma Library Sync",
  "description": "When a new CSS pattern file is created in src/ui/patterns/, remind the agent to activate the figma-library-sync skill and sync the new component to the Figma library file including variables, component set, code syntax, and code snippets.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "src/ui/patterns/*.css"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new component CSS pattern was created. When the component is stable and ready for library sync, the user can activate the figma-library-sync skill to push it to the Figma library (variables, component set, code syntax, and code snippets). Mention this to the user but do not start the sync automatically — the CSS may still be in progress."
  }
}