{
  "enabled": true,
  "name": "UI Foundations Context Routing",
  "description": "Before file writes in UI Foundations surfaces, remind the agent to load the relevant project steering files from the grouped .kiro/steering structure.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the pending write touches UI Foundations surfaces, load the relevant project steering first: for `figma/exports/**`, read `.kiro/steering/foundations/token-exports.md`; for `src/ui/patterns/**`, read `.kiro/steering/components/component-patterns.md` and the matching `.kiro/steering/pattern-rules/*.md`; for `src/react/**`, read `.kiro/steering/components/react-wrappers.md`; for `schemas/**`, read `.kiro/steering/figma/figma-connections.md`; for rule generation, read `.kiro/steering/workflows/rule-generation.md`. If the write is unrelated docs/config cleanup, continue normally."
  }
}
