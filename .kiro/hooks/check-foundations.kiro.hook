{
  "enabled": true,
  "name": "Check Foundations",
  "description": "Before writing code or token files, remind the agent to verify alignment with foundation rules. Triggers on all write operations — path scoping is handled in the prompt since preToolUse does not support file pattern filtering.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before making this change, verify it aligns with the foundation rules in docs/foundations/. Key rules: token layering (foundation-001), naming and grouping (foundation-002), color semantics (foundation-003), typography scale (foundation-004), component boundaries (foundation-009), implementation workflow (foundation-010). If unsure, read the relevant foundation doc first. NOTE: This check is most relevant for files in src/ and figma/ — for docs, configs, or steering files, foundation rules generally do not apply."
  }
}