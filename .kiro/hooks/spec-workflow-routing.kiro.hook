{
  "enabled": true,
  "name": "Spec Workflow Routing",
  "description": "Before agent responses, route feature-building requests toward Kiro specs instead of ad hoc implementation when requirements/design/tasks would reduce ambiguity.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the user asks to build a new feature, create a new component, implement a broad workflow, or make a multi-step product change, consider whether a Kiro spec workflow is needed. Use the spec workflow ONLY when the request is ambiguous, scope is unclear, multiple components or architecture decisions are involved, or work will span multiple sessions. If the user provides a well-defined GitHub Issue with clear scope and acceptance criteria, or asks for a straightforward feature, skip the spec and implement directly. Never force the spec workflow on clearly scoped work."
  }
}
