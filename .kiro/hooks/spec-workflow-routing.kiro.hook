{
  "enabled": true,
  "name": "Spec Workflow Routing",
  "description": "Before agent responses, route feature-building requests toward Kiro specs instead of ad hoc implementation when requirements/design/tasks would reduce ambiguity.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the user asks to build a new feature, create a new component, implement a broad workflow, or make a multi-step product change, consider using the Kiro spec workflow with requirements, design, and tasks before implementation. If the user asks for a small direct fix or clearly says not to create a spec, do not force the spec workflow."
  }
}
