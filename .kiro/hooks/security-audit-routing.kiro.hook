{
  "enabled": true,
  "name": "Security Audit Routing",
  "description": "Before agent responses, route explicit security review requests toward the global security-audit skill.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "askAgent",
    "prompt": "If the user is asking for a security audit, vulnerability review, authentication or authorization review, secrets review, prompt-injection review, tool-permission review, dependency/supply-chain audit, or CI/CD deployment security review, activate or suggest the global `security-audit` skill. Use it only when the request is clearly security-oriented; do not turn ordinary implementation work into a security audit."
  }
}
