{
  "mcpServers": {
    "ui-foundations": {
      "command": "node",
      "args": [
        "./packages/mcp-server/dist/mcp/index.js",
        "--root",
        "."
      ],
      "disabled": false,
      "autoApprove": [
        "diagnose_drift",
        "apply_token_fix",
        "validate_system",
        "get_token",
        "search_foundations",
        "get_component",
        "get_pattern",
        "get_rule",
        "validate_token_name",
        "health_check"
      ]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "disabled": false,
      "autoApprove": [
        "get_metadata",
        "get_design_context",
        "get_screenshot",
        "get_variable_defs",
        "search_design_system",
        "whoami",
        "get_context_for_code_connect",
        "use_figma"
      ]
    },
    "figma-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=${FIGMA_TOKEN}",
        "--stdio"
      ],
      "env": {
        "FIGMA_TOKEN": "${FIGMA_TOKEN}"
      },
      "disabled": true,
      "autoApprove": [
        "get_figma_data"
      ]
    },
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp",
      "disabled": false,
      "autoApprove": [
        "get_metadata",
        "get_design_context",
        "get_variable_defs",
        "get_screenshot",
        "add_code_connect_map"
      ]
    }
  }
}