{
  "mcpServers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "disabled": false,
      "autoApprove": [
        "get_metadata",
        "get_design_context",
        "use_figma",
        "get_screenshot",
        "get_variable_defs",
        "search_design_system",
        "whoami"
      ]
    },
    "figma-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=${FIGMA_TOKEN}",
        "--stdio"
      ],
      "env": {
        "FIGMA_TOKEN": "${FIGMA_TOKEN}"
      },
      "disabled": true,
      "autoApprove": [
        "get_figma_data"
      ]
    },
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp",
      "disabled": false,
      "autoApprove": [
        "get_metadata",
        "get_design_context",
        "get_variable_defs",
        "get_screenshot",
        "add_code_connect_map"
      ]
    }
  }
}
