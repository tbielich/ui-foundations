{
  "mcpServers": {
    "figma-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "figma-developer-mcp",
        "--figma-api-key=${FIGMA_TOKEN}",
        "--stdio"
      ],
      "env": {
        "FIGMA_TOKEN": "${FIGMA_TOKEN}"
      },
      "disabled": false,
      "autoApprove": []
    },
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp",
      "disabled": false,
      "autoApprove": [
        "get_metadata",
        "get_design_context",
        "get_variable_defs"
      ]
    }
  }
}