{# ─── Calendar Macro ────────────────────────────────────────────── #}
{# Append to site/_includes/macros/ui.njk or import separately #}

{% macro calendar(month='2026-07', selectedDate='', todayDate='', state='default', disabled=false, className='') -%}
{%- set calendarClasses = "calendar" -%}
{%- if className -%}{%- set calendarClasses = calendarClasses + " " + className -%}{%- endif -%}

{%- set weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] -%}

<div class="{{ calendarClasses }}" role="group" aria-label="Calendar">
  <div class="calendar-header">
    <button type="button" class="calendar-nav-prev" aria-label="Previous month"{{ " disabled" if disabled }}>‹</button>
    <span class="calendar-title" aria-live="polite">{{ month }}</span>
    <button type="button" class="calendar-nav-next" aria-label="Next month"{{ " disabled" if disabled }}>›</button>
  </div>
  <div class="calendar-weekdays" role="row">
    {%- for day in weekdays %}
    <span class="calendar-weekday" role="columnheader">{{ day }}</span>
    {%- endfor %}
  </div>
  <div class="calendar-grid" role="grid">
    {%- for i in range(1, 32) %}
    {%- set cellClasses = "calendar-cell" -%}
    {%- if state == "hover" and i == 15 -%}{%- set cellClasses = cellClasses + " is-hover" -%}{%- endif -%}
    {%- if state == "focus" and i == 15 -%}{%- set cellClasses = cellClasses + " is-focus-visible" -%}{%- endif -%}
    {%- if selectedDate and i == selectedDate | int -%}{%- set cellClasses = cellClasses + " is-selected" -%}{%- endif -%}
    {%- if todayDate and i == todayDate | int -%}{%- set cellClasses = cellClasses + " is-today" -%}{%- endif -%}
    {%- if disabled -%}{%- set cellClasses = cellClasses + " is-disabled" -%}{%- endif -%}
    <button type="button" class="{{ cellClasses }}"{{ " disabled" if disabled }} tabindex="{{ 0 if i == 1 else -1 }}">{{ i }}</button>
    {%- endfor %}
  </div>
</div>
{%- endmacro %}
