{%- from "macros/calendar.njk" import calendar as _cal -%}
{%- macro calendar(month='2026-07', selectedDate='', todayDate='', state='default', disabled=false, container=true, className='', id='', rangeStart='', rangeEnd='') -%}
{{- _cal(month, selectedDate, todayDate, state, disabled, container, className, id, rangeStart, rangeEnd) }}
{%- endmacro -%}

{% macro card(layout='vertical', interactive=false, selected=false, href='', className='') -%}
{%- set classes = "uif-card" -%}
{%- if layout == "horizontal" -%}{%- set classes = classes + " horizontal" -%}{%- endif -%}
{%- if interactive -%}{%- set classes = classes + " interactive" -%}{%- endif -%}
{%- if selected -%}{%- set classes = classes + " is-selected" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
{%- if href -%}
<a class="{{ classes }}" href="{{ href }}"{% if selected %} aria-current="true"{% endif %}>{{ caller() }}</a>
{%- else -%}
<article class="{{ classes }}"{% if interactive %} tabindex="0"{% endif %}{% if selected %} aria-selected="true"{% endif %}>{{ caller() }}</article>
{%- endif -%}
{%- endmacro %}

{% macro cardMedia(src='', alt='', className='') -%}
{%- set classes = "uif-card-media" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">
  {%- if src %}<img src="{{ src }}" alt="{{ alt }}" />{% else %}{{ caller() }}{%- endif -%}
</div>
{%- endmacro %}

{% macro cardHeader(className='') -%}
{%- set classes = "uif-card-header" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro cardBody(className='') -%}
{%- set classes = "uif-card-body" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro cardFooter(className='') -%}
{%- set classes = "uif-card-footer" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{% macro skeleton(shape='text', size='', width='', animated=true) -%}
{%- set classes = "uif-skeleton" -%}
{%- if shape -%}{%- set classes = classes + " " + shape -%}{%- endif -%}
{%- if size == "sm" or size == "lg" -%}{%- set classes = classes + " " + size -%}{%- endif -%}
{%- if width == "short" or width == "medium" -%}{%- set classes = classes + " " + width -%}{%- endif -%}
{%- if not animated -%}{%- set classes = classes + " no-animation" -%}{%- endif -%}
<span class="{{ classes }}" role="status" aria-label="Loading…" aria-busy="true"></span>
{%- endmacro %}
