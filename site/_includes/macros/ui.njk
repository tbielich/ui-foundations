{% macro toggleButton(label, dataName, dataValue, variant='outline') -%}
{%- set classes = "uif-button" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
<button class="{{ classes }}" type="button"{% if dataName == "mode" %} data-mode="{{ dataValue }}"{% endif %}{% if dataName == "brand" %} data-brand="{{ dataValue }}"{% endif %}{% if dataName == "lang" %} data-lang="{{ dataValue }}"{% endif %} aria-pressed="false">{{ label }}</button>
{%- endmacro %}

{% macro button(label, variant='', disabled=false, type='button') -%}
{%- set resolvedVariant = variant if variant == "outline" or variant == "ghost" else "solid" -%}
{%- set classes = "uif-button " + resolvedVariant -%}
<button type="{{ type }}" class="{{ classes }}"{% if disabled %} disabled{% endif %}>{{ label }}</button>
{%- endmacro %}

{% macro buttonGroup(attached=false, orientation='horizontal', justify='start', ariaLabel='', className='') -%}
{%- set resolvedOrientation = "vertical" if orientation == "vertical" else "horizontal" -%}
{%- set resolvedJustify = "stretch" if justify == "stretch" else "start" -%}
{%- set classes = "uif-button-group" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}" role="group" data-orientation="{{ resolvedOrientation }}" data-attached="{{ "true" if attached else "false" }}" data-justify="{{ resolvedJustify }}"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro input(type='text', placeholder='', value='', state='default', disabled=false, className='', id='', name='', dataPlaygroundControl=false, dataProp='', dataSource='', dataValueType='', dataQueryParam='') -%}
{%- set wrapperClasses = "uif-input-field" -%}
{%- if state == "hover" -%}{%- set wrapperClasses = wrapperClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set wrapperClasses = wrapperClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set wrapperClasses = wrapperClasses + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set wrapperClasses = wrapperClasses + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set wrapperClasses = wrapperClasses + " " + className -%}{%- endif -%}
<div class="{{ wrapperClasses }}">
  <input class="uif-input" type="{{ type }}"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if dataPlaygroundControl %} data-playground-control{% endif %}{% if dataProp %} data-prop="{{ dataProp }}"{% endif %}{% if dataSource %} data-source="{{ dataSource }}"{% endif %}{% if dataValueType %} data-value-type="{{ dataValueType }}"{% endif %}{% if dataQueryParam %} data-query-param="{{ dataQueryParam }}"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-input-field-control">
    {%- if type == "text" or type == "email" or type == "search" or type == "url" or type == "tel" -%}
    <button type="button" aria-label="Clear input" tabindex="-1"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross-circled.svg');" aria-hidden="true"></span></button>
    {%- elif type == "number" -%}
    <button type="button" aria-label="Decrease value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/minus-circled.svg');" aria-hidden="true"></span></button>
    <button type="button" aria-label="Increase value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/plus-circled.svg');" aria-hidden="true"></span></button>
    {%- elif type == "password" -%}
    <button type="button" aria-label="Toggle password visibility"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/view.svg');" aria-hidden="true"></span></button>
    {%- elif type == "date" -%}
    <button type="button" aria-label="Open date picker"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/calendar.svg');" aria-hidden="true"></span></button>
    {%- endif -%}
  </span>
</div>
{%- endmacro %}

{% macro checkbox(label='Checkbox', checked=false, disabled=false, state='default', indeterminate=false, className='', wrapperClassName='', id='', name='', value='on') -%}
{%- set checkboxClasses = "uif-checkbox" -%}
{%- set fieldClasses = "uif-checkbox-field" -%}
{%- if checked -%}{%- set checkboxClasses = checkboxClasses + " is-checked" -%}{%- endif -%}
{%- if indeterminate or state == "indeterminate" -%}{%- set checkboxClasses = checkboxClasses + " is-indeterminate" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set checkboxClasses = checkboxClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set checkboxClasses = checkboxClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set checkboxClasses = checkboxClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set checkboxClasses = checkboxClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set checkboxClasses = checkboxClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ checkboxClasses }}" type="checkbox"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if indeterminate or state == "indeterminate" %} aria-checked="mixed"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-checkbox-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro radio(label='Option', checked=false, disabled=false, state='default', className='', wrapperClassName='', id='', name='', value='') -%}
{%- set radioClasses = "uif-radio" -%}
{%- set fieldClasses = "uif-radio-field" -%}
{%- if checked -%}{%- set radioClasses = radioClasses + " is-checked" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set radioClasses = radioClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set radioClasses = radioClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set radioClasses = radioClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set radioClasses = radioClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set radioClasses = radioClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ radioClasses }}" type="radio"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-radio-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro switch(label='Notifications', checked=false, disabled=false, state='default', className='', wrapperClassName='', id='', name='', value='on') -%}
{%- set switchClasses = "uif-switch" -%}
{%- set fieldClasses = "uif-switch-field" -%}
{%- if checked -%}{%- set switchClasses = switchClasses + " is-checked" -%}{%- endif -%}
{%- if state == "hover" -%}{%- set switchClasses = switchClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set switchClasses = switchClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set switchClasses = switchClasses + " is-focus-visible" -%}{%- endif -%}
{%- if disabled or state == "disabled" -%}
  {%- set switchClasses = switchClasses + " is-disabled" -%}
  {%- set fieldClasses = fieldClasses + " is-disabled" -%}
{%- endif -%}
{%- if className -%}{%- set switchClasses = switchClasses + " " + className -%}{%- endif -%}
{%- if wrapperClassName -%}{%- set fieldClasses = fieldClasses + " " + wrapperClassName -%}{%- endif -%}
<label class="{{ fieldClasses }}">
  <input class="{{ switchClasses }}" type="checkbox" role="switch"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
  <span class="uif-switch-field-text">{{ label }}</span>
</label>
{%- endmacro %}

{% macro rangeSlider(label='Range', min=0, max=100, lowerValue=25, upperValue=75, step=1, disabled=false, className='', id='', lowerName='', upperName='', lowerAriaLabel='Minimum value', upperAriaLabel='Maximum value') -%}
{%- set fieldClasses = "uif-range-slider-field" -%}
{%- if disabled -%}{%- set fieldClasses = fieldClasses + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set fieldClasses = fieldClasses + " " + className -%}{%- endif -%}
{%- set sliderId = id or "range-slider" -%}
<div class="{{ fieldClasses }}">
  <div class="uif-range-slider-header">
    <span class="uif-range-slider-label">{{ label }}</span>
    <output class="uif-range-slider-value" aria-live="polite">
      <span class="uif-range-slider-value-lower">{{ lowerValue }}</span>
      <span class="uif-range-slider-value-separator">–</span>
      <span class="uif-range-slider-value-upper">{{ upperValue }}</span>
    </output>
  </div>
  <div class="uif-range-slider" data-min="{{ min }}" data-max="{{ max }}" data-lower-value="{{ lowerValue }}" data-upper-value="{{ upperValue }}">
    <input class="uif-range-slider-input is-lower" type="range"{% if id %} id="{{ sliderId }}-lower"{% endif %}{% if lowerName %} name="{{ lowerName }}"{% endif %} min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ lowerValue }}" aria-label="{{ lowerAriaLabel }}"{% if disabled %} disabled{% endif %} />
    <input class="uif-range-slider-input is-upper" type="range"{% if id %} id="{{ sliderId }}-upper"{% endif %}{% if upperName %} name="{{ upperName }}"{% endif %} min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ upperValue }}" aria-label="{{ upperAriaLabel }}"{% if disabled %} disabled{% endif %} />
  </div>
</div>
{%- endmacro %}

{% macro colorChip(token) -%}
<div class="swatch" style="--swatch-color: var({{ token.cssVar }})">
  <span class="swatch-name">{{ token.name }}</span>
  <span class="swatch-meta">{{ token.value }}</span>
</div>
{%- endmacro %}

{% macro icon(name, label='', className='') -%}
{%- set classes = "uif-icon" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" style="--uif-icon-src: url('/assets/icons/{{ name }}.svg');"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}></span>
{%- endmacro %}

{% macro labelContent(text='', startIcon='', endIcon='', iconOnly=false) -%}
<span class="uif-label-content{% if iconOnly %} is-icon-only{% endif %}">
  {%- if startIcon %}<span class="uif-icon" data-slot="start" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
  {%- if not iconOnly %}<span class="uif-label-content-text">{{ text }}</span>{% endif -%}
  {%- if endIcon %}<span class="uif-icon" data-slot="end" style="--uif-icon-src: url('/assets/icons/{{ endIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
</span>
{%- endmacro %}

{% macro fieldLabel(text, htmlFor='', required=false, startIcon='') -%}
<label class="uif-field-label"{% if htmlFor %} for="{{ htmlFor }}"{% endif %}>
  <span class="uif-label-content">
    {%- if startIcon %}<span class="uif-icon" data-slot="start" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
    <span class="uif-label-content-text">{{ text }}</span>
  </span>
  {%- if required %}
  <span class="uif-field-label-required" aria-hidden="true">*</span>
  <span class="uif-field-label-required-text"> (required)</span>
  {%- endif %}
</label>
{%- endmacro %}

{% macro link(text, href='#', startIcon='', endIcon='', state='', disabled=false) -%}
{%- set classes = "uif-link" -%}
{%- if state -%}{%- set classes = classes + " is-" + state -%}{%- endif -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
<a class="{{ classes }}" href="{{ href }}"{% if disabled %} aria-disabled="true"{% endif %}>
  {%- if startIcon %}<span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span> {% endif -%}
  {{ text }}
  {%- if endIcon %} <span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ endIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
</a>
{%- endmacro %}

{% macro badge(text, variant='', size='', startIcon='') -%}
{%- set classes = "uif-badge" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if size == "sm" -%}{%- set classes = classes + " sm" -%}{%- endif -%}
<span class="{{ classes }}">
  {%- if startIcon %}<span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ startIcon }}.svg');" aria-hidden="true"></span>{% endif -%}
  <span class="uif-badge-text">{{ text }}</span>
</span>
{%- endmacro %}

{% macro statusLight(text, variant='neutral', size='md') -%}
{%- set classes = "uif-status-light" -%}
{%- if variant and variant != "neutral" -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if size == "sm" -%}{%- set classes = classes + " sm" -%}{%- endif -%}
<span class="{{ classes }}">
  <span class="uif-status-light-indicator" aria-hidden="true"></span>
  <span class="uif-status-light-text">{{ text }}</span>
</span>
{%- endmacro %}

{% macro divider(orientation='horizontal', variant='', className='') -%}
{%- set classes = "uif-divider" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<hr class="{{ classes }}"{% if orientation == "vertical" %} aria-orientation="vertical"{% endif %} />
{%- endmacro %}

{% macro textarea(placeholder='', value='', disabled=false, readonly=false, rows='', state='default', className='') -%}
{%- set classes = "uif-textarea" -%}
{%- if state == "hover" -%}{%- set classes = classes + " is-hover" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set classes = classes + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<textarea class="{{ classes }}"{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if rows %} rows="{{ rows }}"{% endif %}{% if readonly %} readonly{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %}>{{ value }}</textarea>
{%- endmacro %}

{% macro avatar(src='', alt='', initials='', size='', className='') -%}
{%- set classes = "uif-avatar" -%}
{%- if size and size != "md" -%}{%- set classes = classes + " " + size -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" role="img" aria-label="{{ alt or initials }}">
  {%- if src -%}<img src="{{ src }}" alt="{{ alt }}" />{%- else -%}<span class="uif-avatar-initials">{{ initials }}</span>{%- endif -%}
</span>
{%- endmacro %}

{% macro illustratedMessage(preset='empty', heading='', description='', actionLabel='', actionHref='', actionVariant='solid', illustrationIcon='', illustrationHtml='', actionHtml='', className='') -%}
{%- set resolvedPreset = preset if preset == "error" or preset == "no-results" or preset == "empty" else "empty" -%}
{%- set defaultHeading = "Nothing here yet" -%}
{%- set defaultDescription = "Add content or create a new item to get started." -%}
{%- set defaultIcon = "message-info" -%}
{%- if resolvedPreset == "error" -%}
  {%- set defaultHeading = "Something went wrong" -%}
  {%- set defaultDescription = "Try again or go back to the previous step." -%}
  {%- set defaultIcon = "message-alert" -%}
{%- elif resolvedPreset == "no-results" -%}
  {%- set defaultHeading = "No results found" -%}
  {%- set defaultDescription = "Try adjusting your filters or search terms." -%}
  {%- set defaultIcon = "search" -%}
{%- endif -%}
{%- set resolvedHeading = heading or defaultHeading -%}
{%- set resolvedDescription = description or defaultDescription -%}
{%- set resolvedIcon = illustrationIcon or defaultIcon -%}
{%- set resolvedActionVariant = actionVariant if actionVariant == "outline" or actionVariant == "ghost" else "solid" -%}
{%- set resolvedActionHref = "#" -%}
{%- if actionHref and (actionHref.startsWith("https://") or actionHref.startsWith("http://") or actionHref.startsWith("mailto:") or actionHref.startsWith("tel:") or actionHref.startsWith("/") or actionHref.startsWith("#")) -%}
  {%- set resolvedActionHref = actionHref -%}
{%- endif -%}
{%- set classes = "uif-illustrated-message" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
{# illustrationHtml/actionHtml are trusted author markup hooks, not user-content sinks. #}
<div class="{{ classes }}" data-preset="{{ resolvedPreset }}">
  <div class="uif-illustrated-message-illustration" aria-hidden="true">
    {%- if illustrationHtml -%}{{ illustrationHtml | safe }}{%- else -%}<span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ resolvedIcon }}.svg');" aria-hidden="true"></span>{%- endif -%}
  </div>
  <div class="uif-illustrated-message-content">
    {%- if resolvedHeading %}<h2 class="uif-illustrated-message-heading">{{ resolvedHeading }}</h2>{% endif -%}
    {%- if resolvedDescription %}<p class="uif-illustrated-message-description">{{ resolvedDescription }}</p>{% endif -%}
  </div>
  {%- if actionHtml or actionLabel -%}
  <div class="uif-illustrated-message-actions">
    {%- if actionHtml -%}{{ actionHtml | safe }}{%- elif actionHref -%}<a class="uif-button {{ resolvedActionVariant }}" href="{{ resolvedActionHref }}">{{ actionLabel }}</a>{%- else -%}<button class="uif-button {{ resolvedActionVariant }}" type="button">{{ actionLabel }}</button>{%- endif -%}
  </div>
  {%- endif %}
</div>
{% macro progressCircle(value=0, indeterminate=false, size='md', ariaLabel='', ariaLabelledby='', className='') -%}
{%- set classes = "uif-progress-circle" -%}
{%- if size == "sm" or size == "lg" -%}{%- set classes = classes + " " + size -%}{%- endif -%}
{%- if indeterminate -%}{%- set classes = classes + " is-indeterminate" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}" role="progressbar"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}{% if ariaLabelledby %} aria-labelledby="{{ ariaLabelledby }}"{% endif %}{% if not indeterminate %} aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ value or 0 }}"{% endif %}{% if not indeterminate %} style="--_progress-circle-value: {{ value or 0 }};"{% endif %}>
  <svg class="uif-progress-circle-svg" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle class="uif-progress-circle-track" cx="16" cy="16" r="14" pathLength="100"></circle>
    <circle class="uif-progress-circle-indicator" cx="16" cy="16" r="14" pathLength="100"></circle>
  </svg>
</span>
{%- endmacro %}

{% macro accordion(className='') -%}
{%- set classes = "uif-accordion" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro accordionItem(title='', open=false, disabled=false) -%}
{%- set classes = "uif-accordion-item" -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
<details class="{{ classes }}"{% if open %} open{% endif %}>
  <summary>{{ title }}</summary>
  <div class="uif-accordion-item-content">{{ caller() }}</div>
</details>
{%- endmacro %}

{% macro treeView(selection='single', className='') -%}
{%- set classes = "uif-tree-view" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<ul class="{{ classes }}" role="tree" data-selection="{{ "multi" if selection == "multi" else "single" }}">{{ caller() }}</ul>
{%- endmacro %}

{% macro treeNode(label='', expanded=false, selected=false, disabled=false, id='', lazyUrl='') -%}
{%- set children = caller() if caller else "" -%}
{%- set hasChildren = children|trim -%}
{%- set classes = "uif-tree-node" -%}
{%- if expanded -%}{%- set classes = classes + " is-expanded" -%}{%- endif -%}
{%- if selected -%}{%- set classes = classes + " is-selected" -%}{%- endif -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
<li class="{{ classes }}" role="treeitem" aria-selected="{{ "true" if selected else "false" }}"{% if expanded or hasChildren or lazyUrl %} aria-expanded="{{ "true" if expanded else "false" }}"{% endif %}{% if id %} data-node-id="{{ id }}"{% endif %}{% if lazyUrl %} data-lazy-url="{{ lazyUrl }}"{% endif %}>
  <div class="uif-tree-node-row" tabindex="-1">
    {% if hasChildren or lazyUrl %}<button class="uif-tree-toggle" type="button" aria-label="Toggle node"></button>{% endif %}
    <span class="uif-tree-label">{{ label }}</span>
  </div>
  {% if hasChildren %}
  <ul class="uif-tree-children" role="group">
    {{ children }}
  </ul>
  {% endif %}
</li>
{%- endmacro %}

{% macro tabList(orientation='horizontal', ariaLabel='', className='') -%}
{%- set classes = "uif-tab-list" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}" role="tablist" aria-orientation="{{ orientation }}"{% if ariaLabel %} aria-label="{{ ariaLabel }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro tab(label='', selected=false, disabled=false, controls='', href='') -%}
{%- set classes = "uif-tab" -%}
{%- if selected -%}{%- set classes = classes + " is-active" -%}{%- endif -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if href -%}
<a class="{{ classes }}" href="{{ href }}"{% if disabled %} aria-disabled="true" tabindex="-1"{% endif %}>{{ label }}</a>
{%- else -%}
<button class="{{ classes }}" role="tab" type="button" aria-selected="{{ "true" if selected else "false" }}"{% if controls %} aria-controls="{{ controls }}"{% endif %}{% if disabled %} disabled{% endif %} tabindex="{{ "0" if selected else "-1" }}">{{ label }}</button>
{%- endif -%}
{%- endmacro %}

{% macro tabPanels(className='') -%}
{%- set classes = "uif-tab-panels" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro tabPanel(id='', hidden=false) -%}
<div class="uif-tab-panel" role="tabpanel"{% if id %} id="{{ id }}"{% endif %}{% if hidden %} hidden{% endif %} tabindex="0">{{ caller() }}</div>
{%- endmacro %}

{% macro tooltip(text='', placement='top', className='') -%}
{%- set classes = "uif-tooltip-trigger" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<span class="{{ classes }}">{{ caller() }}<span class="uif-tooltip" role="tooltip" data-placement="{{ placement }}">{{ text }}</span></span>
{%- endmacro %}

{% macro form(borderless=false, className='') -%}
{%- set classes = "uif-form" -%}
{%- if borderless -%}{%- set classes = classes + " borderless" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<form class="{{ classes }}" novalidate>{{ caller() }}</form>
{%- endmacro %}

{% macro formGroup(title='', className='') -%}
{%- set classes = "uif-form-group" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<fieldset class="{{ classes }}">
  {%- if title %}<legend class="uif-form-group-title">{{ title }}</legend>{% endif -%}
  {{ caller() }}
</fieldset>
{%- endmacro %}

{% macro formField(labelPosition='top', invalid=false, className='') -%}
{%- set classes = "uif-form-field" -%}
{%- if invalid -%}{%- set classes = classes + " is-invalid" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}"{% if labelPosition == "side" %} data-label-position="side"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{% macro select(options=[], placeholder='', value='', state='default', disabled=false, invalid=false, className='', id='', name='') -%}
{%- set classes = "uif-select" -%}
{%- if state == "hover" -%}{%- set classes = classes + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set classes = classes + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set classes = classes + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if invalid -%}{%- set classes = classes + " is-invalid" -%}{%- endif -%}
{%- if not value and placeholder -%}{%- set classes = classes + " is-placeholder" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<select class="{{ classes }}"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %}>
  {%- if placeholder %}
  <option value="" disabled{% if not value %} selected{% endif %}>{{ placeholder }}</option>
  {%- endif -%}
  {%- for opt in options -%}
    {%- if opt.group %}
  <optgroup label="{{ opt.group }}">
      {%- for item in opt.items %}
    <option value="{{ item.value }}"{% if item.value == value %} selected{% endif %}>{{ item.label }}</option>
      {%- endfor %}
  </optgroup>
    {%- else %}
  <option value="{{ opt.value }}"{% if opt.value == value %} selected{% endif %}>{{ opt.label }}</option>
    {%- endif -%}
  {%- endfor %}
</select>
{%- endmacro %}


{% macro combobox(options=[], placeholder='', value='', query='', state='default', disabled=false, invalid=false, loading=false, allowCustomValue=false, className='', id='', name='', open=false) -%}
{%- set classes = "uif-combobox" -%}
{%- if state == "hover" -%}{%- set classes = classes + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set classes = classes + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set classes = classes + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if invalid -%}{%- set classes = classes + " is-invalid" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
{%- set inputValue = query or value -%}
{%- set normalizedQuery = inputValue|lower -%}
{%- set exactMatch = false -%}
{%- set visibleOptions = [] -%}
{%- for opt in options -%}
  {%- if inputValue and ((opt.label and opt.label|lower == inputValue|lower) or (opt.value and opt.value|lower == inputValue|lower)) -%}
    {%- set exactMatch = true -%}
  {%- endif -%}
  {%- set haystack = (((opt.label or "") + "\n" + (opt.value or "") + "\n" + (opt.description or "") + "\n" + (opt.group or "") + "\n" + ((opt.keywords or [])|join("\n"))) | lower) -%}
  {%- if not normalizedQuery or normalizedQuery in haystack -%}
    {%- set _ = visibleOptions.push(opt) -%}
  {%- endif -%}
{%- endfor -%}
<div class="{{ classes }}" data-open="{{ "true" if open else "false" }}" data-loading="{{ "true" if loading else "false" }}">
  <div class="uif-combobox-field">
    <input class="uif-combobox-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="{{ "true" if open else "false" }}"{% if id %} id="{{ id }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if inputValue %} value="{{ inputValue }}"{% endif %}{% if invalid %} aria-invalid="true"{% endif %}{% if loading %} aria-busy="true"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %} />
    <span class="uif-combobox-control">
      {%- if inputValue and not disabled and state != "disabled" -%}
      <button type="button" aria-label="Clear input" tabindex="-1"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross-circled.svg');" aria-hidden="true"></span></button>
      {%- endif -%}
      {%- if loading -%}
      <span data-loading-indicator><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/sync.svg');" aria-hidden="true"></span></span>
      {%- endif -%}
      <button type="button" aria-label="Toggle suggestions" tabindex="-1"{% if disabled or state == "disabled" %} disabled{% endif %}><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/chevron--down.svg');" aria-hidden="true"></span></button>
    </span>
  </div>
  <input class="uif-combobox-value" type="hidden"{% if name %} name="{{ name }}"{% endif %}{% if value %} value="{{ value }}"{% endif %} />
  <div class="uif-combobox-listbox" role="listbox"{% if not open %} hidden{% endif %}>
    {%- for opt in visibleOptions -%}
    <button type="button" class="uif-combobox-option{% if opt.value == value %} is-active{% endif %}{% if opt.disabled %} is-disabled{% endif %}" role="option" aria-selected="{{ "true" if opt.value == value else "false" }}"{% if opt.disabled %} disabled{% endif %}>
      <span class="uif-combobox-option-label">{{ opt.label }}</span>
      {%- if opt.description or opt.group %}<span class="uif-combobox-option-meta">{{ opt.description or opt.group }}</span>{% endif %}
    </button>
    {%- endfor -%}
    {%- if allowCustomValue and query and not exactMatch -%}
    <button type="button" class="uif-combobox-option" role="option" aria-selected="false">
      <span class="uif-combobox-option-label">Use “{{ query }}”</span>
      <span class="uif-combobox-option-meta">Free-form value</span>
    </button>
    {%- elif loading -%}
    <div class="uif-combobox-status" role="status" aria-live="polite">
      <span class="uif-combobox-option-label">Loading options…</span>
      <span class="uif-combobox-option-meta">Results update when loading completes.</span>
    </div>
    {%- elif open and not visibleOptions.length -%}
    <div class="uif-combobox-empty" role="status" aria-live="polite">
      <span class="uif-combobox-option-label">No matches found</span>
      <span class="uif-combobox-option-meta">Try a different search term.</span>
    </div>
    {%- endif -%}
  </div>
</div>
{%- endmacro %}

{% macro formHelper(text='') -%}
<p class="uif-form-field-helper">{{ text }}</p>
{%- endmacro %}

{% macro formActions(align='end', className='') -%}
{%- set classes = "uif-form-actions" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}"{% if align != "end" %} data-align="{{ align }}"{% endif %}>{{ caller() }}</div>
{%- endmacro %}

{# ─── Table ───────────────────────────────────────────────────────── #}

{% macro tableWrapper(className='') -%}
{%- set classes = "uif-table-wrapper" -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}">{{ caller() }}</div>
{%- endmacro %}

{% macro table(density='', selection='', sortable=false, resizable=false, className='') -%}
{%- set classes = "uif-table" -%}
{%- if density -%}{%- set classes = classes + " uif-table--" + density -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="uif-table-wrapper"><table class="{{ classes }}"{% if selection %} data-selection="{{ selection }}"{% endif %}>{{ caller() }}</table></div>
{%- endmacro %}

{% macro tableHead() -%}
<thead>{{ caller() }}</thead>
{%- endmacro %}

{% macro tableBody() -%}
<tbody>{{ caller() }}</tbody>
{%- endmacro %}

{% macro tableFoot() -%}
<tfoot>{{ caller() }}</tfoot>
{%- endmacro %}

{% macro th(label='', sort=false, resizable=false, className='') -%}
{%- if sort -%}<th{% if className %} class="{{ className }}"{% endif %} aria-sort="none">{{ label }}</th>
{%- elif resizable -%}<th{% if className %} class="{{ className }}"{% endif %} data-resizable>{{ label }}</th>
{%- else -%}<th{% if className %} class="{{ className }}"{% endif %}>{{ label }}</th>
{%- endif -%}
{%- endmacro %}

{% macro tr(cells=[], selected=false, className='') -%}
<tr{% if selected %} aria-selected="true"{% endif %}{% if className %} class="{{ className }}"{% endif %}>
  {%- for cell in cells -%}<td>{{ cell }}</td>{%- endfor -%}
</tr>
{%- endmacro %}

{% macro td(className='') -%}
<td{% if className %} class="{{ className }}"{% endif %}>{{ caller() }}</td>
{% macro inlineAlert(title='', description='', variant='', icon='', dismissible=false, className='') -%}
{%- set classes = "uif-inline-alert" -%}
{%- if variant -%}{%- set classes = classes + " " + variant -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
{%- if not icon -%}
  {%- if variant == "info" -%}{%- set icon = "info-circled" -%}
  {%- elif variant == "positive" -%}{%- set icon = "checkmark-circled" -%}
  {%- elif variant == "negative" -%}{%- set icon = "cross-circled" -%}
  {%- elif variant == "notice" -%}{%- set icon = "exclamation-mark-circled" -%}
  {%- else -%}{%- set icon = "info-circled" -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ classes }}" role="alert">
  <span class="uif-inline-alert-icon"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/{{ icon }}.svg');" aria-hidden="true"></span></span>
  <div class="uif-inline-alert-content">
    {%- if title %}<strong class="uif-inline-alert-title">{{ title }}</strong>{% endif -%}
    {%- if description %}<p class="uif-inline-alert-description">{{ description }}</p>{% endif -%}
    {%- if caller %}<span class="uif-inline-alert-action">{{ caller() }}</span>{% endif -%}
  </div>
  {%- if dismissible %}<button type="button" class="uif-inline-alert-dismiss" aria-label="Dismiss"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/cross.svg');" aria-hidden="true"></span></button>{% endif -%}
{% macro actionBar(count=0, open=false, label='Bulk actions', dismissLabel='Dismiss', className='') -%}
{%- set classes = "uif-action-bar" -%}
{%- if open -%}{%- set classes = classes + " is-open" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
{%- set countText = (count | string) + (" item selected" if count == 1 else " items selected") -%}
<div class="{{ classes }}" role="toolbar" aria-label="{{ label }}">
  <span class="uif-action-bar-count" aria-live="polite">{{ countText }}</span>
  <div class="uif-action-bar-actions">{{ caller() if caller }}</div>
  <span class="uif-action-bar-spacer" aria-hidden="true"></span>
  <button type="button" class="uif-action-bar-dismiss" aria-label="{{ dismissLabel }}">
    <span class="uif-icon" style="--uif-icon-src: url('/assets/icons/close.svg')" aria-hidden="true"></span>
  </button>
{% macro dropzone(label='Drag and drop files here', hint='or', buttonLabel='Choose files', accept='', multiple=false, disabled=false, filled=false, filesText='', className='', id='', name='files') -%}
{%- set classes = "uif-dropzone" -%}
{%- if disabled -%}{%- set classes = classes + " is-disabled" -%}{%- endif -%}
{%- if filled -%}{%- set classes = classes + " is-filled" -%}{%- endif -%}
{%- if className -%}{%- set classes = classes + " " + className -%}{%- endif -%}
<div class="{{ classes }}" role="group" aria-label="File upload drop zone">
  <input class="uif-dropzone-input" type="file"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if accept %} accept="{{ accept }}"{% endif %}{% if multiple %} multiple{% endif %}{% if disabled %} disabled{% endif %} />
  <span class="uif-icon" style="--uif-icon-src: url('/assets/icons/upload.svg');" aria-hidden="true"></span>
  <span class="uif-dropzone-label">{{ label }}</span>
  <span class="uif-dropzone-hint">{{ hint }}</span>
  <button class="uif-button outline uif-dropzone-button" type="button"{% if disabled %} disabled{% endif %}>{{ buttonLabel }}</button>
  <span class="uif-dropzone-files" aria-live="polite">{{ filesText if filesText else ("Files selected" if filled else "No files selected") }}</span>
{% macro numberField(value='', min='', max='', step='', format='', placeholder='0', disabled=false, readonly=false, state='default', className='', id='', name='') -%}
{%- set wrapperClasses = "uif-input-field uif-number-field" -%}
{%- if state == "hover" -%}{%- set wrapperClasses = wrapperClasses + " is-hover" -%}{%- endif -%}
{%- if state == "active" -%}{%- set wrapperClasses = wrapperClasses + " is-active" -%}{%- endif -%}
{%- if state == "focus" -%}{%- set wrapperClasses = wrapperClasses + " is-focus-visible" -%}{%- endif -%}
{%- if state == "disabled" or disabled -%}{%- set wrapperClasses = wrapperClasses + " is-disabled" -%}{%- endif -%}
{%- if className -%}{%- set wrapperClasses = wrapperClasses + " " + className -%}{%- endif -%}
<div class="{{ wrapperClasses }}">
  {%- if format == "currency" -%}<span class="uif-number-field-prefix" aria-hidden="true">$</span>{%- endif -%}
  <input class="uif-input" type="number"{% if id %} id="{{ id }}"{% endif %}{% if name %} name="{{ name }}"{% endif %}{% if placeholder %} placeholder="{{ placeholder }}"{% endif %}{% if value %} value="{{ value }}"{% endif %}{% if min %} min="{{ min }}"{% endif %}{% if max %} max="{{ max }}"{% endif %}{% if step %} step="{{ step }}"{% endif %}{% if disabled or state == "disabled" %} disabled{% endif %}{% if readonly %} readonly{% endif %} />
  {%- if format == "percent" -%}<span class="uif-number-field-suffix" aria-hidden="true">%</span>{%- endif -%}
  <span class="uif-input-field-control">
    <button type="button" aria-label="Decrease value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/minus-circled.svg');" aria-hidden="true"></span></button>
    <button type="button" aria-label="Increase value"><span class="uif-icon" style="--uif-icon-src: url('/assets/icons/plus-circled.svg');" aria-hidden="true"></span></button>
  </span>
</div>
{%- endmacro %}

