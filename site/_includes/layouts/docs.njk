<!DOCTYPE html>
{% import "macros/ui.njk" as ui %}
<html lang="en" data-brand="a" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} · {% endif %}UI Foundations Docs</title>
    <link rel="stylesheet" href="/vendor/ui-foundations/main.css" />
    <link rel="stylesheet" href="/assets/vendor/prism/prism.css" />
    <link rel="stylesheet" href="/assets/docs.css" />
  </head>
  <body>
    <div class="docs-shell">
      <aside class="docs-sidebar">
        <a class="docs-logo" href="/">UI Foundations</a>

        <div class="docs-search" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-owns="docs-search-results">
          <input type="search" class="docs-search-input" placeholder="Search tokens & components" aria-label="Search documentation" aria-autocomplete="list" aria-controls="docs-search-results" autocomplete="off" />
          <ul id="docs-search-results" class="docs-search-results" role="listbox" hidden></ul>
        </div>

        <nav class="docs-nav" aria-label="Documentation navigation">
          <nav class="docs-nav-group" aria-label="Foundations">
            <details{% if page.url.indexOf("/foundations/") == 0 %} open{% endif %}>
              <summary class="docs-nav-group-toggle">Foundations</summary>
              <ul>
                {% for entry in collections.foundationsDocs %}
                <li>
                  <a
                    href="{{ entry.url }}"
                    {% if entry.url == page.url %}aria-current="page"{% endif %}
                  >
                    {{ entry.data.navTitle or entry.data.title }}
                  </a>
                </li>
                {% endfor %}
              </ul>
            </details>
          </nav>

          <nav class="docs-nav-group" aria-label="Components">
            <details{% if page.url.indexOf("/components/") == 0 or page.url == "/components/" %} open{% endif %}>
              <summary class="docs-nav-group-toggle">Components</summary>
              <ul>
                {% for entry in collections.componentsDocs %}
                <li>
                  <a
                    href="{{ entry.url }}"
                    {% if entry.url == page.url %}aria-current="page"{% endif %}
                  >
                    {{ entry.data.navTitle or entry.data.title }}
                  </a>
                </li>
                {% endfor %}
              </ul>
            </details>
          </nav>

          <nav class="docs-nav-group" aria-label="Examples">
            <details{% if page.url.indexOf("/examples/") == 0 or page.url == "/examples/" %} open{% endif %}>
              <summary class="docs-nav-group-toggle">Examples</summary>
              <ul>
                {% for entry in collections.examplesDocs %}
                <li>
                  <a
                    href="{{ entry.url }}"
                    {% if entry.url == page.url %}aria-current="page"{% endif %}
                  >
                    {{ entry.data.navTitle or entry.data.title }}
                  </a>
                </li>
                {% endfor %}
              </ul>
            </details>
          </nav>

          <ul class="docs-nav-top">
            <li>
              <a
                href="/getting-started/"
                {% if page.url == "/getting-started/" %}aria-current="page"{% endif %}
              >
                Getting Started
              </a>
            </li>
          </ul>
        </nav>
      </aside>

      <main class="docs-main">
        <article class="docs-content">
          {% set compactTitleInBreadcrumb = isPlayground and breadcrumb and breadcrumb.length %}

          {# Auto-generate breadcrumb from URL when no manual breadcrumb is set #}
          {% if not breadcrumb or not breadcrumb.length %}
            {% set autoCrumbs = [] %}
            {% set urlParts = page.url | replace(r/^\//, "") | replace(r/\/$/, "") %}
            {% if urlParts %}
              {% set segments = urlParts.split("/") %}
              {% if segments.length >= 1 %}
                {% set sectionSlug = segments[0] %}
                {% set sectionLabel = sectionSlug | replace("-", " ") | capitalize %}
                {% if sectionSlug == "getting-started" %}
                  {% set sectionLabel = "Getting Started" %}
                {% endif %}
                {% set _ = autoCrumbs.push({ label: sectionLabel, url: "/" + sectionSlug + "/" }) %}
              {% endif %}
              {% if segments.length >= 3 %}
                {% set parentSlug = segments[1] %}
                {% set parentLabel = parentSlug | replace("-", " ") | capitalize %}
                {% set _ = autoCrumbs.push({ label: parentLabel, url: "/" + segments[0] + "/" + parentSlug + "/" }) %}
              {% endif %}
              {% set _ = autoCrumbs.push({ label: title or page.fileSlug }) %}
            {% endif %}
            {% set breadcrumb = autoCrumbs if autoCrumbs.length > 1 else [] %}
          {% endif %}

          {% if breadcrumb and breadcrumb.length %}
          <nav class="docs-breadcrumb" aria-label="Breadcrumb">
            <ol>
              {% for item in breadcrumb %}
              <li>
                {% if item.url %}
                <a href="{{ item.url }}">{{ item.label }}</a>
                {% else %}
                <span aria-current="page">{{ item.label }}</span>
                {% endif %}
              </li>
              {% endfor %}
            </ol>
          </nav>
          {% endif %}
          {% set isComponentsOverview = page.url == "/components/" or page.url == "/components" %}
          {% set isComponentDoc = page.url and page.url.indexOf("/components/") == 0 and not isPlayground and not isComponentsOverview %}
          {% set hasFigmaConnection = figmaConnections and figmaConnections.byName and figmaConnections.byName[page.fileSlug] %}
          {% set figmaComponentUrl = figmaConnections and figmaConnections.urlsByName and figmaConnections.urlsByName[page.fileSlug] %}
          {% set showDraftPrefix = isComponentDoc and not hasFigmaConnection %}
          {% if title and not compactTitleInBreadcrumb %}
          <h1>
            {% if showDraftPrefix %}<span class="docs-draft-stamp">!Draft</span>{% endif %}
            {{ title }}
          </h1>
          {% endif %}
          {% if description and not isPlayground %}<p class="page-intro">{{ description }}</p>{% endif %}
          {{ content | safe }}
        </article>
      </main>
    </div>

    <footer class="docs-footer">
      <a href="/impressum/">Impressum</a>
    </footer>

    <script id="docs-search-index" type="application/json">{{ collections.searchIndex | dump | safe }}</script>
    <script src="/assets/docs-search.js"></script>

    <script>
      // Right-side TOC: extract h2[id] headings and build nav + scroll spy
      (function () {
        var headings = document.querySelectorAll(".docs-content h2[id]");
        if (headings.length < 2) return;

        var aside = document.createElement("aside");
        aside.className = "docs-toc-sidebar";
        aside.setAttribute("aria-label", "On this page");

        var title = document.createElement("p");
        title.className = "docs-toc-sidebar-title";
        title.textContent = "On this page";
        aside.appendChild(title);

        var ul = document.createElement("ul");
        ul.className = "docs-toc-sidebar-list";

        headings.forEach(function (h) {
          var li = document.createElement("li");
          var a = document.createElement("a");
          a.href = "#" + h.id;
          a.textContent = h.textContent;
          a.dataset.tocTarget = h.id;
          li.appendChild(a);
          ul.appendChild(li);
        });

        aside.appendChild(ul);

        var main = document.querySelector(".docs-main");
        if (main) main.appendChild(aside);

        // Scroll spy
        var links = ul.querySelectorAll("a");
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                links.forEach(function (l) { l.classList.remove("is-active"); });
                var active = ul.querySelector('[data-toc-target="' + entry.target.id + '"]');
                if (active) active.classList.add("is-active");
              }
            });
          },
          { rootMargin: "-80px 0px -60% 0px", threshold: 0 }
        );

        headings.forEach(function (h) { observer.observe(h); });
      })();
    </script>

    <script>
      // Hero preview: inline brand/mode switching via token snapshot
      (function () {
        var previews = document.querySelectorAll(".docs-hero-preview");
        if (!previews.length) return;

        var root = document.documentElement;

        function getTokens() {
          var styles = getComputedStyle(root);
          var tokens = {};
          for (var s = 0; s < document.styleSheets.length; s++) {
            try {
              var rules = document.styleSheets[s].cssRules;
              for (var r = 0; r < rules.length; r++) {
                var rule = rules[r];
                var inner = rule.cssRules ? rule.cssRules : [rule];
                for (var i = 0; i < inner.length; i++) {
                  var text = inner[i].cssText || "";
                  var matches = text.match(/--[\w-]+/g);
                  if (matches) {
                    matches.forEach(function (prop) {
                      var val = styles.getPropertyValue(prop).trim();
                      if (val) tokens[prop] = val;
                    });
                  }
                }
              }
            } catch (e) {}
          }
          return tokens;
        }

        function applySnapshot(stage, brand, mode) {
          var origBrand = root.dataset.brand;
          var origMode = root.dataset.mode;
          root.dataset.brand = brand;
          root.dataset.mode = mode;
          getComputedStyle(root).getPropertyValue("--color-text-default");
          var tokens = getTokens();
          root.dataset.brand = origBrand;
          root.dataset.mode = origMode;
          var cssText = "";
          Object.keys(tokens).forEach(function (prop) {
            cssText += prop + ":" + tokens[prop] + ";";
          });
          stage.style.cssText = cssText;
        }

        previews.forEach(function (preview) {
          var stage = preview.querySelector(".docs-hero-preview-stage");
          if (!stage) return;

          var currentBrand = root.dataset.brand || "a";
          var currentMode = root.dataset.mode || "light";

          applySnapshot(stage, currentBrand, currentMode);

          var brandBtns = preview.querySelectorAll("[data-hero-brand]");
          var modeBtns = preview.querySelectorAll("[data-hero-mode]");
          brandBtns.forEach(function (b) {
            b.setAttribute("aria-pressed", b.dataset.heroBrand === currentBrand ? "true" : "false");
          });
          modeBtns.forEach(function (b) {
            b.setAttribute("aria-pressed", b.dataset.heroMode === currentMode ? "true" : "false");
          });

          brandBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
              currentBrand = btn.dataset.heroBrand;
              brandBtns.forEach(function (b) {
                b.setAttribute("aria-pressed", b === btn ? "true" : "false");
              });
              applySnapshot(stage, currentBrand, currentMode);
            });
          });

          modeBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
              currentMode = btn.dataset.heroMode;
              modeBtns.forEach(function (b) {
                b.setAttribute("aria-pressed", b === btn ? "true" : "false");
              });
              applySnapshot(stage, currentBrand, currentMode);
            });
          });
        });
      })();
    </script>
    <script>
      // Code tab switcher — syncs all tab groups to the same language
      (function() {
        var stored = localStorage.getItem("ui-foundations-code-tab") || "html";
        var groups = document.querySelectorAll(".code-tabs");

        function activate(group, lang) {
          var buttons = group.querySelectorAll("[data-lang]");
          var panels = group.querySelectorAll(".code-tabs-panel");
          buttons.forEach(function(b) {
            var active = b.dataset.lang === lang;
            b.setAttribute("aria-pressed", active ? "true" : "false");
            b.classList.toggle("is-active", active);
          });
          panels.forEach(function(p) { p.classList.toggle("is-active", p.dataset.lang === lang); });
        }

        function switchAll(lang) {
          stored = lang;
          localStorage.setItem("ui-foundations-code-tab", lang);
          groups.forEach(function(g) { activate(g, lang); });
        }

        groups.forEach(function(g) {
          activate(g, stored);
          g.addEventListener("click", function(e) {
            var btn = e.target.closest("[data-lang]");
            if (btn) switchAll(btn.dataset.lang);
          });
        });
      })();
    </script>
    <script src="/assets/vendor/prism/prism.js"></script>
    <script src="/assets/vendor/prism/prism-markup.min.js"></script>
    <script src="/assets/vendor/prism/prism-jsx.min.js"></script>
    <script src="/assets/playground/shared.js"></script>
    <script src="/assets/playground/state.js"></script>
    <script src="/assets/playground/code.js"></script>
    <script src="/assets/playground/renderers.js"></script>
    <script src="/assets/playground/code-generators.js"></script>
    <script src="/assets/playground.js"></script>
    <script>
      // Sync is-checked class with native :checked state for radio, checkbox, switch
      (function () {
        function sync(input) {
          var isChecked = input.checked;
          input.classList.toggle("is-checked", isChecked);
          if (input.type === "radio" && input.name) {
            var siblings = document.querySelectorAll('input[type="radio"][name="' + input.name + '"]');
            siblings.forEach(function (sib) {
              if (sib !== input) sib.classList.remove("is-checked");
            });
          }
        }
        document.addEventListener("change", function (e) {
          var t = e.target;
          if (t.matches && t.matches('.radio, .checkbox, .switch')) sync(t);
        });
      })();
    </script>
  </body>
</html>
